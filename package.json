{
  "name": "waseela-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Waseela — skrip ops root (brand, tes, rilis web/Android/desktop). Aplikasi Vue ada di app/.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node scripts/apply-brand.mjs",
    "build": "npm run build --prefix app",
    "deploy": "npm run build --prefix app && npx firebase deploy --only hosting:main",
    "firebase:deploy": "npx firebase deploy --only hosting:main",
    "build:apk": "node scripts/build-apk.cjs",
    "build:aab": "node scripts/build-aab.cjs",
    "electron:release": "node scripts/electron-release.cjs",
    "sync:ammu": "node scripts/sync-from-ammu.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vitest": "^2.1.8"
  }
}
